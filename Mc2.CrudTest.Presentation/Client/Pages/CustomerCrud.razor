@page "/Customer"
@inject HttpClient Http
@inject IJSRuntime JS
@using System.Net.Http.Json
@using Mc2.CrudTest.DomainModel.DTO.Customer
@using Mc2.CrudTest.DomainModel.Model
@using System.Text.Json
@using Mc2.CrudTest.Presentation.Client.ViewModel
@using Mc2.CrudTest.Presentation.Server.ViewModel
@using Microsoft.AspNetCore.Components

<div class="modal fade" id="addCustomerData" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Add Customer</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="FirstName">FirstName</label>
                    <input @bind="newCustomer.FirstName" id="FirstName" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="LastName">LastName</label>
                    <input @bind="newCustomer.LastName" id="LastName" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="DateBirth">DateBirth</label>
                    <input @bind="newCustomer.DateOfBirth" type="date" id="datepicker" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="PhoneNumber">PhoneNumber</label>
                    <input @bind="newCustomer.PhoneNumber" id="PhoneNumber" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="Email">Email</label>
                    <input @bind="newCustomer.Email" type="email" id="Email" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="BankAccountNumber">BankAccountNumber</label>
                    <input @bind="newCustomer.BankAccountNumber" id="BankAccountNumber" class="form-control" />
                </div>
            </div>
            <div class="modal-footer">
                <button @onclick="AddCustomer" type="button" class="btn btn-secondary">Add New</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="customerModal" tabindex="-1" aria-labelledby="customerModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="customerModalLabel">Edit Customer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="@updateCustomer" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="form-group">
                        <label for="FirstName">First Name</label>
                        <InputText id="FirstName" class="form-control" @bind-Value="updateCustomer.FirstName" />
                    </div>
                    <div class="form-group">
                        <label for="LastName">Last Name</label>
                        <InputText id="LastName" class="form-control" @bind-Value="updateCustomer.LastName" />
                    </div>
                    <div class="form-group">
                        <label for="DateOfBirth">Date of Birth</label>
                        <InputDate id="DateOfBirth" class="form-control" @bind-Value="updateCustomer.DateOfBirth" />
                    </div>
                    <div class="form-group">
                        <label for="PhoneNumber">Phone Number</label>
                        <InputText id="PhoneNumber" class="form-control" @bind-Value="updateCustomer.PhoneNumber" />
                    </div>
                    <div class="form-group">
                        <label for="Email">Email</label>
                        <InputText id="Email" class="form-control" @bind-Value="updateCustomer.Email" />
                    </div>
                    <div class="form-group">
                        <label for="BankAccountNumber">Bank Account Number</label>
                        <InputText id="BankAccountNumber" class="form-control" @bind-Value="updateCustomer.BankAccountNumber" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-primary">Save changes</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>



<h3>Customer List</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (customers == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table table-bordered table-responsive table-striped" id="dataTable">
        <thead>
            <tr>
                <th>CustomerId</th>
                <th>FirstName</th>
                <th>LastName</th>
                <th>DateOfBirth</th>
                <th>PhoneNumber</th>
                <th>Email</th>
                <th>BankAccountNumber</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @{
            var i = 0;
        }
        @foreach (var item in customers)
        {
            i++;
            <tr>
                <td>@i</td>
                <td>@item.FirstName</td>
                <td>@item.LastName</td>
                <td>@item.DateOfBirth.ToShortDateString()</td>
                <td>@item.PhoneNumber</td>
                <td>@item.Email</td>
                <td>@item.BankAccountNumber</td>
                <td>
                        <button data-bs-toggle="modal" data-bs-target="#customerModal" @onclick="() => ShowEditCustomerModal(item)" class="btn btn-primary">Edit</button>
                    <button @onclick="() => ConfirmDeleteCustomer(item.CustomerId)" class="btn btn-danger">Delete</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <button id="AddData" class="btn btn-secondary " data-bs-toggle="modal" data-bs-target="#addCustomerData">Add</button>
}


@code {
    private List<Customer> customers = new List<Customer>();
    private string errorMessage;
    private CustomerAddViewModel newCustomer = new CustomerAddViewModel();
    private CustomerUpdateViewModel updateCustomer = new CustomerUpdateViewModel();

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
        newCustomer = new CustomerAddViewModel
        {
            DateOfBirth = DateTime.Now 
        };
    }

    private async Task HandleValidSubmit()
    {
        await UpdateCustomer();

        await JS.InvokeVoidAsync("modalHelper.hideModal", "customerModal");
    }

    private  void ShowEditCustomerModal(Customer customer)
    {
        updateCustomer = new CustomerUpdateViewModel
        {
            CustomerId = customer.CustomerId,
            FirstName = customer.FirstName,
            LastName = customer.LastName,
            DateOfBirth = customer.DateOfBirth,
            PhoneNumber = customer.PhoneNumber,
            Email = customer.Email,
            BankAccountNumber = customer.BankAccountNumber
        };
    }

    private async Task UpdateCustomer()
    {
        var response = await Http.PutAsJsonAsync("https://localhost:44308/api/Customer/UpdateData", updateCustomer);
        if (response.IsSuccessStatusCode)
        {
            customers.Clear();
            await LoadCustomers();
            updateCustomer = new CustomerUpdateViewModel();
            await JS.InvokeVoidAsync("SuccessMessage", "Customer updated successfully!");
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("ErrorMessage", error);
        }
    }

    private async Task LoadCustomers()
    {
        try
        {
            var response = await Http.GetAsync("https://localhost:44308/api/Customer/GetCustomers");

            if (response.IsSuccessStatusCode)
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                var customerList = JsonSerializer.Deserialize<List<Customer>>(jsonString, new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    });

                if (customerList != null)
                {
                    customers.AddRange(customerList);
                }
            }
            else
            {
                errorMessage = $"Error fetching customers: {response.ReasonPhrase}";
                Console.Error.WriteLine(errorMessage);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error fetching customers: {ex.Message}";
            Console.Error.WriteLine(errorMessage);
        }
    }

    private async Task AddCustomer()
    {
        var response = await Http.PostAsJsonAsync("https://localhost:44308/api/Customer/AddData", newCustomer);
        if (response.IsSuccessStatusCode)
        {
            // Reload or update the customer list
           
            customers.Clear();
            await LoadCustomers();
            newCustomer = new CustomerAddViewModel();
            await JS.InvokeVoidAsync("modalHelper.hideModal", "addCustomerData");
            await JS.InvokeVoidAsync("SuccessMessage", "Customer added successfully!");
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("ErrorMessage", error);
        }
    }

    private async Task ConfirmDeleteCustomer(int customerId)
    {
        var result = await JS.InvokeAsync<bool>("confirmDelete");

        if (result)
        {
            await DeleteCustomer(customerId);
        }
    }

    private async Task DeleteCustomer(int customerId)
    {
        var response = await Http.DeleteAsync($"https://localhost:44308/api/Customer/DeleteData/{customerId}");
        if (response.IsSuccessStatusCode)
        {
            customers.Clear();
            await LoadCustomers();
            await JS.InvokeVoidAsync("SuccessMessage", "Customer deleted successfully!");
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync(); // Read the error message as a string
            await JS.InvokeVoidAsync("ErrorMessage", error);
        }
    }
}
